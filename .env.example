# ---------------------------------------------------------------------------
# ExploreBD environment configuration
# Copy to `.env` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public app (safe to expose in the browser — VITE_* variables are public)
VITE_APP_NAME=ExploreBD
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_LOCALE=bn-BD
VITE_API_BASE_URL=/api

# Map style (optional basemap). Leave default for OpenFreeMap; the map also
# works with a neutral background if tiles are unavailable.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Routing provider. `haversine` needs no key. `openrouteservice` proxies through
# the Worker, where the secret key lives.
VITE_ROUTING_PROVIDER=haversine
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_BASE_URL=https://api.heigit.org
OPENROUTESERVICE_API_KEY=

# Weather provider. `disabled` by default.
VITE_WEATHER_PROVIDER=disabled
WEATHER_PROVIDER=disabled
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
R2_BUCKET_NAME=

# Turnstile (server-side validation required). Site key is public.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application security
IP_HASH_SECRET=
SHARE_SIGNING_SECRET=

# Allowed origins for the Worker CORS policy (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
