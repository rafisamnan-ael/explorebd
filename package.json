{
  "name": "explorebd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ExploreBD - Bangladesh travel progress, discovery and trip planning platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply explorebd --local",
    "db:migrate:remote": "wrangler d1 migrations apply explorebd --remote",
    "scripts:geo": "tsx scripts/import-admin-data.ts",
    "scripts:sitemap": "tsx scripts/generate-sitemap.ts",
    "scripts:validate-geo": "tsx scripts/validate-geo.ts",
    "scripts:validate-content": "tsx scripts/validate-content.ts",
    "scripts:validate": "npm run scripts:validate-geo && npm run scripts:validate-content",
    "scripts:hero-images": "tsx scripts/fetch-hero-images.ts"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-sans-bengali": "^5.1.0",
    "dexie": "^4.0.10",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^3.87.0"
  }
}
